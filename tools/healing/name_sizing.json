{
  "_doc": "Geonosis label name-sizing reference spec. Self-contained: lets a tweaker size names the canonical way without any external source. NOTE families differ \u2014 SPOOL colour names use font TIERS (no textLength); BOX and MATERIALS letter-fit with textLength. Type names are always letter-fit.",
  "source": "master",
  "families": {
    "spool": {
      "label_mm": [
        45,
        19
      ],
      "type_name": {
        "x": 12.5,
        "y": 6.9,
        "font_mm": 1.7,
        "weight": 700,
        "method": "textLength",
        "textLength_mm": 23.0,
        "lengthAdjust": "spacingAndGlyphs"
      },
      "color_name": {
        "x": 12.5,
        "y": 12.05,
        "anchor": "start",
        "weight": null,
        "method": "font-tiers",
        "use_textLength": false,
        "field_width_mm": 23.0,
        "advance_per_latin_unit": 1.4,
        "over_length": {
          "_doc": "the golden's smallest tier (1.00mm) overflows the longest names; this is the fit applied when no tier fits. Remove this block once the golden constrains them upstream.",
          "compact_font_mm": 0.9,
          "use_textLength": true,
          "lengthAdjust": "spacingAndGlyphs"
        },
        "font_tiers_mm": [
          1.3,
          1.15,
          1.0
        ],
        "tier_max_name_chars": [
          {
            "font_mm": 1.3,
            "max_name_chars": 10
          },
          {
            "font_mm": 1.15,
            "max_name_chars": 14
          },
          {
            "font_mm": 1.0,
            "max_name_chars": 22
          }
        ],
        "rule": "Pick the largest font tier whose estimated WIDTH fits field_width_mm (width is authoritative; tier_max_name_chars are only the golden's rough Latin cutoffs and the 1.00mm one OVERFLOWS in practice). Width is CJK-aware: full-width glyphs count as 2 Latin units; effective Latin advance ~1.4x font (mm fonts render wide). OVER-LENGTH (too long even at 1.00mm — true even in the golden, which doesn't constrain these): drop to 0.90mm + textLength=field_width_mm + lengthAdjust=spacingAndGlyphs to letter-compress it to fit; flag it so a tweaker can shorten/truncate. NO textLength when a tier fits."
      }
    },
    "box": {
      "label_mm": [
        22,
        22
      ],
      "type_name": {
        "font_mm": 2.5,
        "weight": 700,
        "method": "textLength"
      },
      "color_name": {
        "x": 1.0,
        "y": 18.03,
        "font_mm": 2.0,
        "method": "textLength",
        "use_textLength": true,
        "rule": "single font 2.00mm, letter-fit to the box width via textLength (box matched the golden as-shipped)."
      }
    },
    "materials": {
      "note": "per size-group; type letter-fit via textLength at a per-group font; secondary text (subtitle/thickness/colour) smaller. Matched the golden as-shipped \u2014 documented for reference.",
      "size_groups_mm": {
        "115x55": {
          "type_font_mm": 1.32,
          "secondary_font_mm": 1.04,
          "method": "textLength"
        },
        "70x35": {
          "type_font_mm": 1.32,
          "secondary_font_mm": 1.04,
          "method": "textLength"
        },
        "70x26": {
          "type_font_mm": 1.32,
          "secondary_font_mm": 1.04,
          "method": "textLength"
        },
        "70x20": {
          "type_font_mm": 1.25,
          "secondary_font_mm": 0.8,
          "method": "textLength"
        }
      }
    }
  },
